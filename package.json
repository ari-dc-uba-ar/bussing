{
  "name": "bussing",
  "version": "0.0.1",
  "description": "Revisa el ambiente local de repositorios después de una tarea: cambios sin commitear o pushear, versiones sin subir o publicar, dependencias cruzadas desactualizadas e instalaciones contaminadas por npm link o devel-sync",
  "author": "ari.dc.uba.ar",
  "license": "MIT",
  "type": "module",
  "main": "dist/bussing.js",
  "types": "dist/bussing.d.ts",
  "exports": {
    ".": {
      "types": "./dist/bussing.d.ts",
      "default": "./dist/bussing.js"
    }
  },
  "bin": {
    "bussing": "dist/bussing-cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p test/tsconfig.json",
    "test": "npm run build && npm run build:test && mocha",
    "test-ci": "npm run build && npm run build:test && c8 mocha",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "cleye": "^2.7.0",
    "guarantee-type": "^0.2.13",
    "js-yaml": "^5.4.3",
    "semver": "^7.8.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@types/semver": "^7.8.0",
    "c8": "^12.0.0",
    "mocha": "^12.0.3",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "git",
    "npm",
    "housekeeping",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ari-dc-uba-ar/bussing.git"
  },
  "bugs": {
    "url": "https://github.com/ari-dc-uba-ar/bussing/issues"
  },
  "homepage": "https://github.com/ari-dc-uba-ar/bussing#readme",
  "qa-control": {
    "run-in": "server",
    "type": "cmd-tool"
  }
}
